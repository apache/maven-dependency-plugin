<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins.dependency.its</groupId>
  <artifactId>copy-maven-coordinates</artifactId>
  <version>1.0-SNAPSHOT</version>
  <description>
    dependency:copy takes the artifact in the form that Maven and dependency:list print.
  </description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>@project.version@</version>
        <executions>
          <execution>
            <id>type-classifier-version-scope</id>
            <phase>process-sources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifact>org.apache.maven.its.dependency:ResourceArtifact:test-jar:tests:1.0:test</artifact>
              <outputDirectory>target/type-classifier-version-scope</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>legacy</id>
            <phase>process-sources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifact>org.apache.maven.its.dependency:ResourceArtifact:1.0:jar:client</artifact>
              <outputDirectory>target/legacy</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>version-only</id>
            <phase>process-sources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifact>org.apache.maven.its.dependency:ResourceArtifact:1.0</artifact>
              <outputDirectory>target/version-only</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
