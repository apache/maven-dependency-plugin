<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.maven.its.dependency</groupId>
    <artifactId>build-classpath-repository-layout</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>module-b</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven.its.dependency</groupId>
      <artifactId>module-a</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>@project.version@</version>
        <executions>
          <!-- negative control: without prefix the reactor module is the file in its build output -->
          <execution>
            <id>no-prefix</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/no-prefix.txt</outputFile>
              <useRepositoryLayout>true</useRepositoryLayout>
            </configuration>
          </execution>
          <!-- negative control: the prefix alone gives file names without directories -->
          <execution>
            <id>prefix-only</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/prefix-only.txt</outputFile>
              <prefix>repository</prefix>
            </configuration>
          </execution>
          <execution>
            <id>layout</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/layout.txt</outputFile>
              <prefix>repository</prefix>
              <useRepositoryLayout>true</useRepositoryLayout>
              <pathSeparator>:</pathSeparator>
              <fileSeparator>/</fileSeparator>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
